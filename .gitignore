cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# Environment variables — NEVER commit these
.env
.env.local
.env.*.local
backend/.env

# Data — too large for git, recreate by running ingest.py
backend/data/chroma_db/
backend/data/raw/

# Node / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/.env.local

# Firebase
.firebase/
firebase-debug.log

# VS Code
.vscode/settings.json

# macOS
.DS_Store

# Logs
*.log
EOF